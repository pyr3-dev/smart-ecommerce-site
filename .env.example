################################################################
# .env.example — copy to .env and fill in all values
# Never commit .env to version control.
################################################################

# ── POSTGRES ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your-super-secret-postgres-password

# ── SUPABASE JWT ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-token-at-least-32-chars
JWT_EXPIRY=3600

# Generate anon + service_role keys from your JWT_SECRET
# Use: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=your-anon-jwt-key
SERVICE_ROLE_KEY=your-service-role-jwt-key

# ── REALTIME / SECRET KEY ────────────────────────────────────────
# Generate with: openssl rand -hex 64
REALTIME_SECRET=your-realtime-encryption-key
SECRET_KEY_BASE=your-phoenix-secret-key-base-at-least-64-chars

# ── URLS ─────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

# ── SMTP (for auth emails) ───────────────────────────────────────
SMTP_ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Ecommerce Platform
MAILER_AUTOCONFIRM=false

# ── STUDIO / DASHBOARD ───────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-studio-dashboard-password
STUDIO_DEFAULT_ORGANIZATION=Enciana Intelligence
STUDIO_DEFAULT_PROJECT=Smart Ecommerce

# ── OAUTH (optional) ─────────────────────────────────────────────
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# ── REDIS ────────────────────────────────────────────────────────
REDIS_PASSWORD=your-redis-password

# ── ANALYTICS SERVER (private repo) ─────────────────────────────
ANALYTICS_API_SECRET=your-analytics-api-secret
ANALYTICS_REPO_PATH=../analytics-server
ANALYTICS_SCORE_CRON=0 2 * * *

# ── LOGFLARE (optional, for Studio logs) ────────────────────────
LOGFLARE_API_KEY=



# ── NEXT.JS ← SUPABASE WIRING ────────────────────────────────
#
# OPTION A — Self-hosted (docker-compose stack, default):
#   URL  = API_EXTERNAL_URL above (Kong gateway)
#   KEY  = ANON_KEY above
#
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-jwt-key
#
# OPTION B — Supabase Cloud:
#   Comment out Option A above and uncomment these two lines instead.
#   Get values from: https://app.supabase.com/project/_/settings/api
#   Note: the Postgres/JWT/SMTP/Redis/Kong variables above are not needed for cloud.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-cloud-anon-key
