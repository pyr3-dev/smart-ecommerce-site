################################################################
# .env.example — copy to .env and fill in values
# Never commit .env to version control.
#
# Backend: Supabase Cloud (https://supabase.com)
# After creating your project, get these from:
#   Project Settings → API
################################################################

# ── SUPABASE (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-side only (never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── APP URL ──────────────────────────────────────────────────
# Used for auth redirects. Set to your production domain in prod.
SITE_URL=http://localhost:3000

# ── ANALYTICS SERVER (optional, private repo) ────────────────
# See README.md → "Advanced Analytics Server" for purchase info.
ANALYTICS_API_SECRET=your-analytics-api-secret
ANALYTICS_REPO_PATH=../analytics-server
ANALYTICS_SCORE_CRON=0 2 * * *
# The analytics server uses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above
